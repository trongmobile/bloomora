---
/**
 * GlassPopover / menu: a disclosure button that reveals a glass panel.
 * Behaviour (aria-expanded, Escape, outside click, focus return) lives in scripts/menu.ts.
 */
interface Props {
  id: string;
  /** Accessible name of the trigger button. */
  label: string;
  class?: string;
}
const { id, label, class: className } = Astro.props;
---

<div class:list={['menu', className]} data-menu>
  <button
    type="button"
    class="btn btn--icon"
    data-menu-trigger
    aria-expanded="false"
    aria-controls={id}
    aria-label={label}
    title={label}
  >
    <slot name="trigger">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </slot>
  </button>
  <div class="menu__panel glass" data-tier="elevated" id={id} data-menu-panel hidden>
    <slot />
  </div>
</div>
