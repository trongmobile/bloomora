---
/** A button or link styled as a glass pill. 44px minimum target. */
interface Props {
  href?: string;
  variant?: 'default' | 'primary' | 'ghost';
  size?: 'md' | 'sm';
  /** Square/round icon-only button: pass an accessible `aria-label`. */
  icon?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [attr: string]: unknown;
}
const { href, variant = 'default', size = 'md', icon = false, type = 'button', class: className, ...rest } = Astro.props;
const classes = [
  'btn',
  variant === 'primary' && 'btn--primary',
  variant === 'ghost' && 'btn--ghost',
  size === 'sm' && 'btn--sm',
  icon && 'btn--icon',
  className,
];
---

{
  href ? (
    <a class:list={classes} href={href} {...rest}>
      <slot />
    </a>
  ) : (
    <button class:list={classes} type={type} {...rest}>
      <slot />
    </button>
  )
}
