---
/** Small bloom mark: five petals around a centre. Decorative; the wordmark carries the name. */
---

<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g transform="translate(16 16)">
    <g fill="#e87a9f">
      <ellipse rx="4.2" ry="8.2" cy="-7" />
      <ellipse rx="4.2" ry="8.2" cy="-7" transform="rotate(72)" />
      <ellipse rx="4.2" ry="8.2" cy="-7" transform="rotate(144)" />
      <ellipse rx="4.2" ry="8.2" cy="-7" transform="rotate(216)" />
      <ellipse rx="4.2" ry="8.2" cy="-7" transform="rotate(288)" />
    </g>
    <circle r="4" fill="#f6c453"></circle>
  </g>
</svg>
