---
import type { FlowerData, Lang, StageId } from '../../data/types';
import { getDict } from '../../i18n';
import { href } from '../../lib/href';
import { routes } from '../../lib/routes';
import { buildPlayerProps } from '../../lib/player-props';
import { absoluteUrl } from '../../lib/url';
import TimeLapsePlayer from '../timelapse/TimeLapsePlayer';

interface Props {
  flower: FlowerData;
  lang: Lang;
  /** Hydrate immediately (above the fold) instead of when scrolled into view. */
  eager?: boolean;
  idPrefix?: string;
  /** Start on this stage (share/moment pages); also swaps the pre-hydration poster for that stage. */
  stage?: StageId;
  /** Embedded use: drops the long notes under the player. */
  compact?: boolean;
}
const { flower, lang, eager = false, idPrefix, stage, compact = false } = Astro.props;
const site = Astro.site ?? 'https://bloomora.example';
const base = import.meta.env.BASE_URL;
const slug = flower.slugs[lang];
const shareUrls = {
  flower: absoluteUrl(site, base, routes.flower(lang, slug)),
  momentBase: absoluteUrl(site, base, routes.momentBase(lang, slug)),
};
const poster = stage ? routes.artMoment(flower.id, stage) : routes.art(flower.id);
const props = {
  ...buildPlayerProps(flower, lang, getDict(lang), href(poster), shareUrls),
  idPrefix,
  initialStage: stage,
  compact,
};
---

{eager ? <TimeLapsePlayer client:load {...props} /> : <TimeLapsePlayer client:visible {...props} />}
