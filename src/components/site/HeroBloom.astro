---
/**
 * Hero emblem: four blooms (dahlia, sunflower, lotus, cherry blossom) cross-fading one after another, with no backdrop.
 * Pure inline SVG and CSS, no script. With reduced motion only the first shows.
 */
import BloomDahlia from './hero/BloomDahlia.astro';
import BloomLotus from './hero/BloomLotus.astro';
import BloomSakura from './hero/BloomSakura.astro';
import BloomSunflower from './hero/BloomSunflower.astro';
---

<div class="bloom-stack" aria-hidden="true">
  <BloomDahlia />
  <BloomSunflower />
  <BloomLotus />
  <BloomSakura />
</div>
