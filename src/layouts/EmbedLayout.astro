---
import '../styles/global.css';
import type { Lang } from '../data/types';
import { HEAD_INIT_SCRIPT } from '../lib/head-script';
import { href } from '../lib/href';
import type { Alternate } from '../lib/pages';
import { buildHead } from '../lib/seo';
import GoatCounterScript from '../components/analytics/GoatCounterScript.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import beVietnamLatin from '../assets/fonts/be-vietnam-pro-latin-400-normal.woff2?url';
import beVietnamVi from '../assets/fonts/be-vietnam-pro-vietnamese-400-normal.woff2?url';
import newsreaderLatin from '../assets/fonts/newsreader-latin-500-normal.woff2?url';
import newsreaderVi from '../assets/fonts/newsreader-vietnamese-500-normal.woff2?url';

/**
 * Bare page for iframes: no header, no footer, no navigation. It is `noindex` (the species page is
 * the one to rank) and honours `?theme=light|dark` so the host page can match its own look.
 */
interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates?: Alternate[];
  image?: { path: string; alt: string };
}

const { lang, ...seo } = Astro.props;
const head = buildHead({ ...seo, lang, noindex: true, site: Astro.site ?? 'https://bloomora.example', base: import.meta.env.BASE_URL });
const THEME_OVERRIDE = `(function(){try{var t=new URLSearchParams(location.search).get('theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t)}catch(e){}})();`;
---

<!doctype html>
<html lang={head.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={HEAD_INIT_SCRIPT} />
    <script is:inline set:html={THEME_OVERRIDE} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={beVietnamLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderLatin} crossorigin />
    {lang === 'vi' && <link rel="preload" as="font" type="font/woff2" href={beVietnamVi} crossorigin />}
    {lang === 'vi' && <link rel="preload" as="font" type="font/woff2" href={newsreaderVi} crossorigin />}
    <SEOHead head={head} />
  </head>
  <body class="embed-body">
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <div id="toast" class="toast glass" data-tier="elevated" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/site';
    </script>
    <GoatCounterScript />
  </body>
</html>
