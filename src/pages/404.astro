---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassButton from '../components/design-system/GlassButton.astro';
import { LANG_STORAGE_KEY } from '../config/site';
import { getDict } from '../i18n';
import { href } from '../lib/href';
import { routes } from '../lib/routes';

// GitHub Pages serves one 404.html for the whole site, so both languages are in the markup and the
// head script below shows the visitor's one (URL prefix, then stored choice, then browser language).
const vi = getDict('vi');
const en = getDict('en');
const titles = { vi: `${vi.notFound.title} | Bloomora`, en: `${en.notFound.title} | Bloomora` };
---

<BaseLayout
  lang="vi"
  bilingual
  noindex
  rawTitle
  title={`${vi.notFound.title} · ${en.notFound.title} | Bloomora`}
  description={vi.notFound.body}
  path="/404.html"
>
  <script
    slot="head"
    is:inline
    define:vars={{ key: LANG_STORAGE_KEY, base: import.meta.env.BASE_URL, titles }}
  >
    (function () {
      try {
        const path = location.pathname.indexOf(base) === 0 ? location.pathname.slice(base.length) : location.pathname;
        const first = path.replace(/^\/+/, '').split('/')[0];
        let lang = first === 'vi' || first === 'en' ? first : null;
        if (!lang) {
          try {
            const stored = localStorage.getItem(key);
            if (stored === 'vi' || stored === 'en') lang = stored;
          } catch {
            // storage blocked: fall through to the browser language
          }
        }
        if (!lang) lang = (navigator.language || '').toLowerCase().indexOf('vi') === 0 ? 'vi' : 'en';
        document.documentElement.setAttribute('data-show-lang', lang);
        document.documentElement.lang = lang;
        document.title = titles[lang];
      } catch {
        // leave the bilingual fallback
      }
    })();
  </script>
  <section class="section">
    <div class="container container--narrow page-center">
      <div lang="vi" data-lang-block="vi">
        <h1>{vi.notFound.title}</h1>
        <p class="lead">{vi.notFound.body}</p>
        <p class="cluster">
          <GlassButton variant="primary" href={href(routes.home('vi'))}>{vi.notFound.home}</GlassButton>
          <GlassButton href={href(routes.flowers('vi'))}>{vi.notFound.flowers}</GlassButton>
        </p>
      </div>
      <hr data-lang-sep />
      <div lang="en" data-lang-block="en">
        <h1>{en.notFound.title}</h1>
        <p class="lead">{en.notFound.body}</p>
        <p class="cluster">
          <GlassButton variant="primary" href={href(routes.home('en'))}>{en.notFound.home}</GlassButton>
          <GlassButton href={href(routes.flowers('en'))}>{en.notFound.flowers}</GlassButton>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
