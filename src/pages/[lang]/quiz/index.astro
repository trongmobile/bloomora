---
import type { GetStaticPaths } from 'astro';
import GlassButton from '../../../components/design-system/GlassButton.astro';
import GlassSurface from '../../../components/design-system/GlassSurface.astro';
import Breadcrumbs from '../../../components/site/Breadcrumbs.astro';
import { FLOWERS } from '../../../data';
import { QUIZ_QUESTIONS, QUIZ_RESULTS } from '../../../data/quiz';
import { LANGS, STAGE_IDS, type Lang } from '../../../data/types';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { fmt, getDict } from '../../../i18n';
import { alternatesFor } from '../../../lib/pages';
import { getRegistry } from '../../../lib/content';
import { href } from '../../../lib/href';
import { breadcrumbLd } from '../../../lib/jsonld';
import { shuffleStable } from '../../../lib/quiz';
import { routes } from '../../../lib/routes';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const dict = getDict(lang);
const q = dict.quiz;
const registry = await getRegistry();
const ctx = { site: Astro.site ?? 'https://bloomora.example', base: import.meta.env.BASE_URL };
const total = QUIZ_QUESTIONS.length + 1;
const crumbs = [
  { name: dict.nav.home, path: routes.home(lang) },
  { name: dict.nav.quiz, path: routes.quiz(lang) },
];
const questions = QUIZ_QUESTIONS.map((question, i) => ({
  ...question,
  options: shuffleStable(question.options, 101 + i * 17),
}));
---

<BaseLayout
  lang={lang}
  title={q.metaTitle}
  description={q.metaDescription}
  path={routes.quiz(lang)}
  alternates={alternatesFor(registry, 'quiz')}
  jsonLd={[breadcrumbLd(ctx, crumbs)]}
>
  <section class="section section--tight">
    <div class="container container--narrow">
      <Breadcrumbs lang={lang} items={crumbs} />
      <h1>{q.title}</h1>
      <p class="lead">{q.lead}</p>
      <noscript><p class="muted">{q.noscript}</p></noscript>

      <GlassSurface
        as="form"
        tier="elevated"
        class="quiz panel"
        data-quiz
        data-result-base={href(`/${lang}/quiz/result/`)}
        data-count-label={q.questionOf}
        aria-label={q.formLabel}
        novalidate
      >
        {
          questions.map((question, i) => (
            <fieldset class="quiz__step" data-quiz-step data-scored>
              <legend class="quiz__legend" tabindex="-1">
                <span class="quiz__n">{fmt(q.questionOf, { n: i + 1, total })}</span>
                {question.prompt[lang]}
              </legend>
              <div class="quiz__options">
                {question.options.map((opt) => (
                  <label class="quiz-option">
                    <input type="radio" name={question.id} value={opt.stage} />
                    <span>{opt.text[lang]}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
        <fieldset class="quiz__step" data-quiz-step data-flower>
          <legend class="quiz__legend" tabindex="-1">
            <span class="quiz__n">{fmt(q.questionOf, { n: total, total })}</span>
            {q.flowerPrompt}
          </legend>
          <p class="muted">{q.flowerHint}</p>
          <div class="quiz__flowers">
            {
              FLOWERS.map((f) => (
                <label class="quiz-flower">
                  <input type="radio" name="flower" value={f.id} />
                  <img src={href(routes.art(f.id))} alt="" width="800" height="600" loading="lazy" decoding="async" />
                  <span>{f.text[lang].name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="quiz__nav" data-quiz-nav hidden>
          <progress class="quiz__progress" max={total} value="1" data-quiz-progress aria-hidden="true"></progress>
          <p class="quiz__count" data-quiz-count aria-live="polite"></p>
          <div class="cluster">
            <GlassButton type="button" data-quiz-back hidden>{q.back}</GlassButton>
            <GlassButton type="submit" variant="primary" data-quiz-next data-label-next={q.next} data-label-done={q.seeResult} disabled>{q.next}</GlassButton>
          </div>
        </div>
      </GlassSurface>
      <p class="muted t-small" style="margin-top: var(--space-4)">{q.disclaimer}</p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="all-results">
    <div class="container container--narrow">
      <h2 id="all-results">{q.allResultsTitle}</h2>
      <ol class="quiz-results-list">
        {
          STAGE_IDS.map((stage) => (
            <li>
              <a href={href(routes.quizResult(lang, stage))}>{QUIZ_RESULTS[stage].text[lang].title}</a>
              <span class="muted"> · {dict.stageNames[stage]}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <script>
    import { initQuiz } from '../../../scripts/quiz';
    initQuiz();
  </script>
</BaseLayout>
