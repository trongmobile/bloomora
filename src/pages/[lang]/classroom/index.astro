---
import type { GetStaticPaths } from 'astro';
import GlassSurface from '../../../components/design-system/GlassSurface.astro';
import Breadcrumbs from '../../../components/site/Breadcrumbs.astro';
import { FLOWERS } from '../../../data';
import { LANGS, type Lang } from '../../../data/types';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDict } from '../../../i18n';
import { alternatesFor } from '../../../lib/pages';
import { getRegistry } from '../../../lib/content';
import { href } from '../../../lib/href';
import { breadcrumbLd } from '../../../lib/jsonld';
import { routes } from '../../../lib/routes';

export const getStaticPaths = (() => LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const dict = getDict(lang);
const c = dict.classroom;
const registry = await getRegistry();
const ctx = { site: Astro.site ?? 'https://bloomora.example', base: import.meta.env.BASE_URL };
const crumbs = [
  { name: dict.nav.home, path: routes.home(lang) },
  { name: dict.nav.classroom, path: routes.classroom(lang) },
];
---

<BaseLayout
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  path={routes.classroom(lang)}
  alternates={alternatesFor(registry, 'classroom')}
  jsonLd={[breadcrumbLd(ctx, crumbs)]}
>
  <section class="section section--tight">
    <div class="container container--narrow">
      <Breadcrumbs lang={lang} items={crumbs} />
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>

      <h2>{c.stepsTitle}</h2>
      <ol>{c.steps.map((step) => <li>{step}</li>)}</ol>

      <h2>{c.activitiesTitle}</h2>
      <div class="care-grid">
        {
          c.activities.map((a) => (
            <GlassSurface tier="subtle" class="panel">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </GlassSurface>
          ))
        }
      </div>

      <h2 style="margin-top: var(--space-7)">{c.resourcesTitle}</h2>
      <div class="table-scroll">
        <table class="planner__table">
          <thead>
            <tr>
              <th scope="col">{c.colFlower}</th>
              <th scope="col">{c.colPresent}</th>
              <th scope="col">{c.colCards}</th>
              <th scope="col">{c.colPage}</th>
            </tr>
          </thead>
          <tbody>
            {
              FLOWERS.map((f) => (
                <tr>
                  <th scope="row">{f.text[lang].name}</th>
                  <td><a href={href(routes.embed(lang, f.slugs[lang]))}>{c.present}</a></td>
                  <td><a href={href(routes.cards(lang, f.slugs[lang]))}>{c.cards}</a></td>
                  <td><a href={href(routes.flower(lang, f.slugs[lang]))}>{c.page}</a></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 style="margin-top: var(--space-7)">{c.embedTitle}</h2>
      <p>{c.embedBody}</p>

      <GlassSurface tier="subtle" class="panel">
        <h2 class="t-subheading">{c.honestTitle}</h2>
        <p>{c.honestBody}</p>
      </GlassSurface>
    </div>
  </section>
</BaseLayout>
