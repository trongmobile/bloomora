---
import type { GetStaticPaths } from 'astro';
import GlassBadge from '../../../components/design-system/GlassBadge.astro';
import GlassSurface from '../../../components/design-system/GlassSurface.astro';
import Breadcrumbs from '../../../components/site/Breadcrumbs.astro';
import FlowerGrid from '../../../components/site/FlowerGrid.astro';
import FlowerPlayer from '../../../components/site/FlowerPlayer.astro';
import ShareActions from '../../../components/site/ShareActions.astro';
import { FLOWERS, relatedFlowers } from '../../../data';
import { LANGS, type FlowerData, type Lang } from '../../../data/types';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDict } from '../../../i18n';
import { CONTENT_UPDATED } from '../../../config/site';
import { formatDayRange } from '../../../lib/duration';
import { alternatesFor } from '../../../lib/pages';
import { getArticles, getRegistry, articleSlug } from '../../../lib/content';
import { href } from '../../../lib/href';
import { articleLd, breadcrumbLd } from '../../../lib/jsonld';
import { routes } from '../../../lib/routes';
import { absoluteUrl } from '../../../lib/url';

export const getStaticPaths = (() =>
  LANGS.flatMap((lang) => FLOWERS.map((flower) => ({ params: { lang, slug: flower.slugs[lang] }, props: { flower } })))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const { flower } = Astro.props as { flower: FlowerData };
const dict = getDict(lang);
const text = flower.text[lang];
const path = routes.flower(lang, flower.slugs[lang]);
const site = Astro.site ?? 'https://bloomora.example';
const base = import.meta.env.BASE_URL;
const ctx = { site, base };
const canonical = absoluteUrl(site, base, path);
const registry = await getRegistry();
const crumbs = [
  { name: dict.nav.home, path: routes.home(lang) },
  { name: dict.flowers.title, path: routes.flowers(lang) },
  { name: text.name, path },
];
const title = `${text.name} (${flower.scientificName}) — ${dict.detail.metaTitleSuffix}`;
const related = relatedFlowers(flower);
const mentioned = (await getArticles(lang)).filter((a) => a.data.relatedFlowers.includes(flower.id));
const care = [
  [dict.detail.careLight, text.care.light],
  [dict.detail.careWater, text.care.water],
  [dict.detail.careSoil, text.care.soil],
  [dict.detail.careTemperature, text.care.temperature],
  ...(text.care.extra ? [[dict.detail.careExtra, text.care.extra]] : []),
] as [string, string][];
const otherNames = (text.aliases ?? []).join(', ');
---

<BaseLayout
  lang={lang}
  title={title}
  description={text.metaDescription}
  path={path}
  alternates={alternatesFor(registry, `flower:${flower.id}`)}
  image={{ path: routes.ogFlower(flower.id), alt: text.altText }}
  type="article"
  publishedTime={CONTENT_UPDATED}
  modifiedTime={CONTENT_UPDATED}
  jsonLd={[
    breadcrumbLd(ctx, crumbs),
    articleLd(ctx, {
      headline: `${text.name} — ${dict.detail.metaTitleSuffix}`,
      description: text.metaDescription,
      path,
      imagePath: routes.ogFlower(flower.id),
      lang,
      datePublished: CONTENT_UPDATED,
      dateModified: CONTENT_UPDATED,
      keywords: text.keywords,
    }),
  ]}
>
  <article>
    <header class="container detail-head">
      <Breadcrumbs lang={lang} items={crumbs} />
      <h1>{text.name}</h1>
      <p class="sci" style="font-size: var(--text-xl); margin-bottom: var(--space-2)">{flower.scientificName}</p>
      <p class="lead">{text.tagline}</p>
      <div class="badges">
        <GlassBadge>{dict.taxonomy.group[flower.group]}</GlassBadge>
        <GlassBadge>{dict.detail.bloomSeason}: {flower.bloomSeasons.map((s) => dict.taxonomy.season[s]).join(', ')}</GlassBadge>
        <GlassBadge>{dict.detail.timeToBloom}: {formatDayRange(flower.daysToBloom, lang)}</GlassBadge>
        <GlassBadge tone={flower.confidence === 'low' ? 'warn' : 'default'}>
          {dict.detail.confidence}: {dict.taxonomy.confidence[flower.confidence]}
        </GlassBadge>
      </div>
      <ShareActions lang={lang} url={canonical} title={`${text.name} — Bloomora`} text={text.tagline} />
    </header>

    <section class="section section--tight container" id="timelapse" aria-labelledby="player-title">
      <h2 id="player-title" class="visually-hidden">{dict.detail.playerTitle}</h2>
      <FlowerPlayer flower={flower} lang={lang} eager />
    </section>

    <div class="container detail-layout section--tight">
      <div class="stack" style="--stack-gap: var(--space-7)">
        <section aria-labelledby="intro-title">
          <h2 id="intro-title">{text.name}</h2>
          {text.intro.map((p) => <p>{p}</p>)}
        </section>

        <section aria-labelledby="stages-title">
          <h2 id="stages-title">{dict.detail.stagesTitle}</h2>
          <p class="muted">{dict.detail.stagesLead}</p>
          <ol class="stage-list">
            {
              flower.stages.map((stage, i) => {
                const st = text.stages[stage.id];
                return (
                  <GlassSurface as="li" tier="subtle">
                    <span class="num" aria-hidden="true">{i + 1}</span>
                    <div>
                      <h3>
                        {st?.name ?? dict.stageNames[stage.id]}
                        <span class="dur">{dict.detail.stageDuration}: {formatDayRange(stage.days, lang)}</span>
                      </h3>
                      <p>{st?.description ?? dict.stageBlurbs[stage.id]}</p>
                    </div>
                  </GlassSurface>
                );
              })
            }
          </ol>
        </section>

        <section aria-labelledby="care-title">
          <h2 id="care-title">{dict.detail.careTitle}</h2>
          <div class="care-grid">
            {
              care.map(([label, body]) => (
                <GlassSurface tier="subtle" class="panel">
                  <h3>{label}</h3>
                  <p>{body}</p>
                </GlassSurface>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="facts-title">
          <h2 id="facts-title">{dict.detail.factsTitle}</h2>
          <ul>{text.facts.map((f) => <li>{f}</li>)}</ul>
        </section>
      </div>

      <aside class="facts-panel" aria-labelledby="quick-title">
        <GlassSurface tier="standard" class="panel">
          <h2 id="quick-title" class="t-subheading">{dict.detail.quickFacts}</h2>
          <dl>
            <dt>{dict.detail.scientificName}</dt>
            <dd class="sci">{flower.scientificName}</dd>
            <dt>{dict.detail.family}</dt>
            <dd>{flower.family}</dd>
            {otherNames && (<><dt>{dict.detail.otherNames}</dt><dd>{otherNames}</dd></>)}
            <dt>{dict.detail.start}</dt>
            <dd>{dict.taxonomy.start[flower.startMaterial]}</dd>
            <dt>{dict.detail.timeToBloom}</dt>
            <dd>{formatDayRange(flower.daysToBloom, lang)}</dd>
          </dl>
          <p class="muted t-small">{text.timeNote}</p>
        </GlassSurface>
      </aside>
    </div>

    <section class="section section--tight container" aria-labelledby="sources-title">
      <h2 id="sources-title">{dict.detail.sourcesTitle}</h2>
      <p class="muted">{dict.detail.sourcesLead}</p>
      <ol class="source-list">
        {
          flower.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer" target="_blank">{s.title}</a> — {s.publisher}
              <span class="supports">{s.supports}</span>
            </li>
          ))
        }
      </ol>
    </section>

    {
      mentioned.length > 0 && (
        <section class="section section--tight container" aria-labelledby="read-title">
          <h2 id="read-title">{dict.detail.readMore}</h2>
          <ul>
            {mentioned.map((a) => <li><a href={href(routes.article(lang, articleSlug(a)))}>{a.data.title}</a></li>)}
          </ul>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="section section--tight container" aria-labelledby="related-title">
          <h2 id="related-title">{dict.detail.relatedTitle}</h2>
          <FlowerGrid flowers={related} lang={lang} />
        </section>
      )
    }
  </article>
</BaseLayout>
