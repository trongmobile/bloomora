{
  "name": "bloomora",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Bloomora — Liquid Glass Flower Time-lapse Explorer",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "og": "tsx scripts/generate-og.ts",
    "clips": "tsx scripts/render-clips.ts",
    "prebuild": "npm run og",
    "build": "astro build && node scripts/verify-build.mjs",
    "build:only": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify-build.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:e2e:base": "BASE_PATH=/bloomora/ SITE_URL=https://owner.github.io npm run build:only && BASE_PATH=/bloomora/ SITE_URL=https://owner.github.io playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "astro": "^6.4.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
