# Copy to .env for local development. In CI these are set by the workflow (see docs/DEPLOYMENT.md).

# Absolute origin of the deployed site (no trailing slash needed).
#   Custom domain:        https://bloomora.example.com
#   GitHub Pages project: https://<user>.github.io
SITE_URL=https://bloomora.example

# Base path. "/" for a custom domain or user site, "/<repo>/" for a project site.
BASE_PATH=/

# GoatCounter Cloud site code (the part before .goatcounter.com). Leave empty to disable analytics.
PUBLIC_GOATCOUNTER_CODE=

# Set to "false" to force-disable analytics even when a code is present.
PUBLIC_ANALYTICS_ENABLED=true

# Optional: Google Search Console HTML-tag verification token (content value only).
PUBLIC_GSC_VERIFICATION=
